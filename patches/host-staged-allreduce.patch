diff -ruN a/distributed/device_communicators/host_staged_all_reduce.py b/distributed/device_communicators/host_staged_all_reduce.py
--- a/distributed/device_communicators/host_staged_all_reduce.py	1970-01-01 01:00:00.000000000 +0100
+++ b/distributed/device_communicators/host_staged_all_reduce.py	2026-10-02 02:46:10.689819832 +0200
@@ -0,0 +1,286 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Host-staged all-reduce for two GPUs without peer-to-peer access.
+
+Consumer cards (e.g. two RTX 3090 without NVLink) have no P2P, so custom
+all-reduce is off and NCCL moves tensor-parallel all-reduces through host
+shared memory with SM-driven copies: ~3.7 GiB/s, which made the all-reduce
+~45% of a prefill and left TP=2 no faster than one card.
+
+Here both ranks map one shared, pinned host buffer and let the copy engines do
+the work. Each rank owns one half of the tensor: it copies the peer's half of
+its contribution to the host, adds the peer's contribution to its own half, and
+copies the reduced half back for the peer -- 1x the tensor out and 1x in per
+rank, ~1.7 ms for 20 MiB against NCCL's 5.3 ms. Cross-rank ordering uses 64-bit
+sequence flags in the shared buffer, written by a one-thread release-store
+kernel and awaited by a one-thread polling kernel (both compiled once with
+NVRTC; stream memory operations wait with a millisecond backoff, and a stream
+blocked on a host semaphore stalls the device's other streams). The CPU never
+waits.
+
+Used for large, eager all-reduces only (prefill chunks); decode-sized tensors
+and anything inside a CUDA-graph capture stay on PyNCCL.
+"""
+
+import ctypes
+import glob
+import mmap
+import os
+import secrets
+
+import torch
+import torch.distributed as dist
+from torch.distributed import ProcessGroup
+
+import vllm.envs as envs
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+_KERNELS_SRC = b"""
+extern "C" __global__ void spin_geq(const unsigned long long* flag, unsigned long long target) {
+    // System-scope load: a volatile load of host memory can be served from L2
+    // and miss the peer's write until the line is evicted.
+    unsigned long long v;
+    for (;;) {
+        asm volatile("ld.relaxed.sys.global.u64 %0, [%1];" : "=l"(v) : "l"(flag) : "memory");
+        if (v >= target) break;
+        __nanosleep(100);
+    }
+}
+
+extern "C" __global__ void set_flag(unsigned long long* flag, unsigned long long value) {
+    // System-scope release: this stream's earlier copies into host memory are
+    // visible before the flag is.
+    asm volatile("st.release.sys.global.u64 [%0], %1;" :: "l"(flag), "l"(value) : "memory");
+}
+"""
+
+_SENT, _RES, _DONE = 0, 1, 2
+_SLOTS = 2
+
+_cuda: ctypes.CDLL | None = None
+_functions: dict = {}
+
+
+def _check(res: int, what: str) -> None:
+    if res != 0:
+        raise RuntimeError(f"{what} failed with error {res}")
+
+
+def _driver() -> ctypes.CDLL:
+    global _cuda
+    if _cuda is None:
+        cu = ctypes.CDLL("libcuda.so.1")
+        cu.cuModuleLoadData.argtypes = [ctypes.POINTER(ctypes.c_void_p), ctypes.c_char_p]
+        cu.cuModuleGetFunction.argtypes = [
+            ctypes.POINTER(ctypes.c_void_p), ctypes.c_void_p, ctypes.c_char_p
+        ]
+        cu.cuLaunchKernel.argtypes = [ctypes.c_void_p] + [ctypes.c_uint] * 7 + [
+            ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p
+        ]
+        _cuda = cu
+    return _cuda
+
+
+def _nvrtc() -> ctypes.CDLL:
+    import nvidia
+
+    for root in nvidia.__path__:
+        for lib in sorted(glob.glob(os.path.join(root, "*", "lib", "libnvrtc.so*"))):
+            return ctypes.CDLL(lib)
+    return ctypes.CDLL("libnvrtc.so")
+
+
+def _compile_cubin(arch: str) -> bytes:
+    # Straight to a cubin: containers often ship no PTX JIT.
+    nv = _nvrtc()
+    prog = ctypes.c_void_p()
+    _check(nv.nvrtcCreateProgram(ctypes.byref(prog), _KERNELS_SRC, b"hsar.cu", 0, None, None),
+           "nvrtcCreateProgram")
+    try:
+        opts = (ctypes.c_char_p * 1)(f"--gpu-architecture={arch}".encode())
+        if nv.nvrtcCompileProgram(prog, 1, opts) != 0:
+            size = ctypes.c_size_t()
+            nv.nvrtcGetProgramLogSize(prog, ctypes.byref(size))
+            log = ctypes.create_string_buffer(size.value)
+            nv.nvrtcGetProgramLog(prog, log)
+            raise RuntimeError(f"nvrtc: {log.value.decode(errors='replace')}")
+        size = ctypes.c_size_t()
+        _check(nv.nvrtcGetCUBINSize(prog, ctypes.byref(size)), "nvrtcGetCUBINSize")
+        cubin = ctypes.create_string_buffer(size.value)
+        _check(nv.nvrtcGetCUBIN(prog, cubin), "nvrtcGetCUBIN")
+        return cubin.raw
+    finally:
+        nv.nvrtcDestroyProgram(ctypes.byref(prog))
+
+
+def _function(device: torch.device, name: bytes) -> ctypes.c_void_p:
+    key = (device.index, name)
+    fn = _functions.get(key)
+    if fn is None:
+        cu = _driver()
+        mod = _functions.get(device.index)
+        if mod is None:
+            major, minor = torch.cuda.get_device_capability(device)
+            mod = ctypes.c_void_p()
+            _check(cu.cuModuleLoadData(ctypes.byref(mod), _compile_cubin(f"sm_{major}{minor}")),
+                   "cuModuleLoadData")
+            _functions[device.index] = mod
+        fn = ctypes.c_void_p()
+        _check(cu.cuModuleGetFunction(ctypes.byref(fn), mod, name), "cuModuleGetFunction")
+        _functions[key] = fn
+    return fn
+
+
+class HostStagedAllReduce:
+    """All-reduce between two ranks on one node through shared pinned host memory."""
+
+    def __init__(self, group: ProcessGroup, device: torch.device) -> None:
+        self.disabled = True
+        self.group = group
+        self.device = device
+        self.world_size = dist.get_world_size(group)
+        self.rank = dist.get_rank(group)
+        self._mm: mmap.mmap | None = None
+        self._host: torch.Tensor | None = None
+        self._ptr = 0
+        if self.world_size != 2:
+            logger.warning_once("Host-staged all-reduce supports world_size=2 only; disabled.")
+            return
+        self.peer = 1 - self.rank
+        index = device.index if device.index is not None else torch.cuda.current_device()
+        devices: list = [None, None]
+        dist.all_gather_object(devices, index, group=group)
+        if torch.cuda.can_device_access_peer(index, devices[self.peer]):
+            logger.info_once("GPUs have P2P access; host-staged all-reduce stays off "
+                             "(custom all-reduce is faster).")
+            return
+        self.min_bytes = envs.VLLM_ALLREDUCE_HOST_STAGED_MIN_KB << 10
+        self.max_bytes = envs.VLLM_ALLREDUCE_HOST_STAGED_MAX_MB << 20
+        half = self.max_bytes // 2
+        self.half_bytes = half
+        data_bytes = 2 * 2 * _SLOTS * half  # (send, res) x rank x slot
+        total = data_bytes + 3 * 2 * _SLOTS * 8
+        self._flags_off = data_bytes
+
+        # Rank 0 creates a fresh (zeroed) shared file; both map it, then it is unlinked.
+        name = [f"vllm-hsar-{os.getpid()}-{secrets.token_hex(6)}" if self.rank == 0 else None]
+        dist.broadcast_object_list(name, src=dist.get_global_rank(group, 0), group=group)
+        path = f"/dev/shm/{name[0]}"
+        try:
+            if self.rank == 0:
+                fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_EXCL, 0o600)
+                os.ftruncate(fd, total)
+                os.close(fd)
+            dist.barrier(group=group)
+            fd = os.open(path, os.O_RDWR)
+            self._mm = mmap.mmap(fd, total)
+            os.close(fd)
+            dist.barrier(group=group)
+        finally:
+            if self.rank == 0 and os.path.exists(path):
+                os.unlink(path)
+        host = torch.frombuffer(self._mm, dtype=torch.uint8)
+        self._ptr = host.data_ptr()
+        # cudaHostRegisterPortable | cudaHostRegisterMapped
+        _check(int(torch.cuda.cudart().cudaHostRegister(self._ptr, total, 0x1 | 0x2)),
+               "cudaHostRegister")
+        self._host = host
+        self.seq = 0
+        with torch.cuda.device(device):
+            self.streams = [torch.cuda.Stream() for _ in range(4)]
+            self.tmp = torch.empty(half, dtype=torch.uint8, device=device)
+            _function(device, b"spin_geq")
+            _function(device, b"set_flag")
+        self.disabled = False
+        logger.info(
+            "Host-staged all-reduce enabled for tensors of %d KiB .. %d MiB (2 x %d MiB pinned host)",
+            self.min_bytes >> 10, self.max_bytes >> 20, data_bytes >> 20,
+        )
+
+    # --- buffers and flags ---------------------------------------------------
+    def _region(self, kind: int, rank: int, slot: int) -> torch.Tensor:
+        off = ((kind * 2 + rank) * _SLOTS + slot) * self.half_bytes
+        return self._host[off: off + self.half_bytes]
+
+    def _flag(self, kind: int, rank: int, slot: int) -> int:
+        return self._ptr + self._flags_off + ((kind * 2 + rank) * _SLOTS + slot) * 8
+
+    def _launch(self, name: bytes, stream: torch.cuda.Stream, addr: int, value: int) -> None:
+        a, v = ctypes.c_uint64(addr), ctypes.c_uint64(value)
+        params = (ctypes.c_void_p * 2)(ctypes.cast(ctypes.byref(a), ctypes.c_void_p),
+                                       ctypes.cast(ctypes.byref(v), ctypes.c_void_p))
+        _check(_driver().cuLaunchKernel(_function(self.device, name), 1, 1, 1, 1, 1, 1, 0,
+                                        stream.cuda_stream, params, None), "cuLaunchKernel")
+
+    # --- all-reduce ----------------------------------------------------------
+    def should_use(self, inp: torch.Tensor) -> bool:
+        if self.disabled or not inp.is_cuda or not inp.is_contiguous():
+            return False
+        if inp.dtype not in (torch.bfloat16, torch.float16, torch.float32):
+            return False
+        nbytes = inp.numel() * inp.element_size()
+        if nbytes < self.min_bytes or nbytes > self.max_bytes or inp.numel() % 2:
+            return False
+        # Both ranks reach the same answer: the gates depend on the shape only,
+        # and a CUDA-graph capture happens on both together.
+        return not torch.cuda.is_current_stream_capturing()
+
+    def all_reduce(self, inp: torch.Tensor) -> torch.Tensor:
+        out = inp.clone()
+        self.seq += 1
+        seq, slot = self.seq, self.seq % _SLOTS
+        n_half = out.numel() // 2
+        flat = out.view(-1)
+        halves = (flat[:n_half], flat[n_half:])
+        mine, theirs = halves[self.rank], halves[self.peer]
+        nb = n_half * out.element_size()
+        tmp = self.tmp[:nb].view(out.dtype)
+        send_mine = self._region(_SENT, self.rank, slot)[:nb].view(out.dtype)
+        send_peer = self._region(_SENT, self.peer, slot)[:nb].view(out.dtype)
+        res_mine = self._region(_RES, self.rank, slot)[:nb].view(out.dtype)
+        res_peer = self._region(_RES, self.peer, slot)[:nb].view(out.dtype)
+        main = torch.cuda.current_stream()
+        s_send, s_add, s_res, s_recv = self.streams
+        ready = main.record_event()
+        for s in self.streams:
+            s.wait_event(ready)
+        # Our contribution to the peer's half -> host (once the peer has read
+        # this slot's previous use).
+        if seq > _SLOTS:
+            self._launch(b"spin_geq", s_send, self._flag(_DONE, self.peer, slot), seq - _SLOTS)
+        with torch.cuda.stream(s_send):
+            send_mine.copy_(theirs, non_blocking=True)
+        self._launch(b"set_flag", s_send, self._flag(_SENT, self.rank, slot), seq)
+        # The peer's contribution to our half -> device, added in.
+        self._launch(b"spin_geq", s_add, self._flag(_SENT, self.peer, slot), seq)
+        with torch.cuda.stream(s_add):
+            tmp.copy_(send_peer, non_blocking=True)
+            mine.add_(tmp)
+        added = s_add.record_event()
+        # Our reduced half -> host.
+        s_res.wait_event(added)
+        with torch.cuda.stream(s_res):
+            res_mine.copy_(mine, non_blocking=True)
+        self._launch(b"set_flag", s_res, self._flag(_RES, self.rank, slot), seq)
+        # The peer's reduced half -> device; then this slot may be reused.
+        self._launch(b"spin_geq", s_recv, self._flag(_RES, self.peer, slot), seq)
+        with torch.cuda.stream(s_recv):
+            theirs.copy_(res_peer, non_blocking=True)
+        s_recv.wait_event(added)
+        self._launch(b"set_flag", s_recv, self._flag(_DONE, self.rank, slot), seq)
+        for s in self.streams:
+            main.wait_stream(s)
+            out.record_stream(s)
+        return out
+
+    def destroy(self) -> None:
+        if self._ptr:
+            torch.cuda.synchronize(self.device)
+            torch.cuda.cudart().cudaHostUnregister(self._ptr)
+            self._ptr = 0
+        self._host = None
+        if self._mm is not None:
+            self._mm.close()
+            self._mm = None
+        self.disabled = True
