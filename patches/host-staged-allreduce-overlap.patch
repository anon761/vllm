+# Row-parallel layers by prefix, for row_parallel_overlap (a custom op takes no
+# module, so it looks the layer up by name).
+_ROW_PARALLEL_LAYERS: dict[str, "RowParallelLinear"] = {}
+
+
+def row_parallel_overlap(x: torch.Tensor, layer_name: str) -> torch.Tensor:
+    """GEMM + TP all-reduce of a row-parallel layer, with the host-staged
+    all-reduce of each token piece running on the copy engines while the next
+    piece's GEMM runs on the SMs. Falls back to one GEMM + all-reduce when the
+    pieces are too small, inside a CUDA-graph capture, or without the backend."""
+    from vllm.distributed import get_tp_group
+
+    layer = _ROW_PARALLEL_LAYERS[layer_name]
+    bias_ = None if (layer.tp_rank > 0 or layer.skip_bias_add) else layer.bias
+    group = get_tp_group()
+    hs = getattr(group.device_communicator, "hs_ar_comm", None)
+    pieces = envs.VLLM_ALLREDUCE_HOST_STAGED_OVERLAP
+    rows = x.shape[0]
+    step = -(-rows // max(pieces, 1))
+    piece_bytes = step * layer.output_size * x.element_size()
+    if (
+        hs is None
+        or hs.disabled
+        or pieces < 2
+        or x.dim() != 2
+        or rows < pieces
+        or piece_bytes < hs.min_bytes
+        or torch.cuda.is_current_stream_capturing()
+    ):
+        return group._all_reduce_out_place(layer.quant_method.apply(layer, x, bias_))
+    handles = []
+    for i in range(0, rows, step):
+        y = layer.quant_method.apply(layer, x[i : i + step], bias_)
+        if hs.should_use(y):
+            handles.append(hs.start(y))
+        else:
+            handles.append((group._all_reduce_out_place(y), ()))
+    return torch.cat([hs.finish(h) for h in handles])
+
+
+def row_parallel_overlap_fake(x: torch.Tensor, layer_name: str) -> torch.Tensor:
+    layer = _ROW_PARALLEL_LAYERS[layer_name]
+    return x.new_empty((*x.shape[:-1], layer.output_size))
+
+
+direct_register_custom_op(
+    op_name="row_parallel_overlap",
+    op_func=row_parallel_overlap,
+    fake_impl=row_parallel_overlap_fake,
+)
+
